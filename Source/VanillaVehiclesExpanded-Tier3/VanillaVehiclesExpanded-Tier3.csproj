<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Authors>Oskar Potocki, xrushha, Smash Phil, Taranchuk, Reann Shepard</Authors>
		<Description>Framework for creating vehicles in RimWorld.</Description>
		<Product>Vanilla Vehicles Expanded Tier 3</Product>
		<RootNamespace>VanillaVehiclesExpanded_Tier3</RootNamespace>
		<AssemblyName>VanillaVehiclesExpanded-Tier3</AssemblyName>
		<FileVersion>1.7.0</FileVersion>
		<AssemblyVersion>1.7.0</AssemblyVersion>

		<Configurations>Debug;Release;</Configurations>
		<Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
		<Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>

		<GenerateDocumentationFile>False</GenerateDocumentationFile>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<Deterministic>true</Deterministic>
		<OutputType>Library</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>preview</LangVersion>
		<FileAlignment>512</FileAlignment>
		<AppDesignerFolder>Properties</AppDesignerFolder>

		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>4</WarningLevel>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<DebugType>embedded</DebugType>
		<DebugSymbols>true</DebugSymbols>

		<UseKrafsPackageRef>false</UseKrafsPackageRef>

		<!-- csproj is adjacent to solution, not Directory build props in mod directory, so go back 2 folders -->
		<ModDir>$(MSBuildThisFileDirectory)..\..\</ModDir>
		<OutDir>$(ModDir)\1.7\Assemblies\</OutDir>
		<RefDir>$(ModDir)..\..\</RefDir>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
		<Optimize>false</Optimize>
		<DefineConstants>TRACE;DEBUG;UNITY_ASSERTIONS;</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
		<Optimize>true</Optimize>
		<DefineConstants>TRACE;RELEASE;</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Lib.Harmony.Ref" Version="2.4.3" />
	</ItemGroup>

	<ItemGroup Condition="'$(UseKrafsPackageRef)' == 'true'">
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.*" />
	</ItemGroup>
	<ItemGroup Condition="'$(UseKrafsPackageRef)' != 'true'">
		<Reference Include="VanillaVehiclesExpanded">
			<HintPath>$(ModDir)\..\VanillaVehiclesExpanded\1.7\Assemblies\VanillaVehiclesExpanded.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Vehicles">
			<HintPath>$(ModDir)\..\Vehicle-Framework\1.7\Assemblies\Vehicles.dll</HintPath>
			<Private>False</Private>
		</Reference>

		<Reference Include="System">
			<HintPath>$(RefDir)\System.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="System.Xml">
			<HintPath>$(RefDir)\System.Xml.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="System.Xml.Linq">
			<HintPath>$(RefDir)\System.Xml.Linq.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="mscorlib">
			<HintPath>$(RefDir)\mscorlib.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityStubs">
			<HintPath>$(RefDir)\UnityStubs.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Assembly-CSharp">
			<HintPath>$(RefDir)\Assembly-CSharp.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Waylith">
			<HintPath>$(RefDir)\Waylith.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Waylith.UnityCompat">
			<HintPath>$(RefDir)\Waylith.UnityCompat.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>
</Project>